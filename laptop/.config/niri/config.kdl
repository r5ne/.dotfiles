// Workspaces (in order)
workspace "browser"
workspace "dev"
workspace "notes"

// Disable the "Important Hotkeys" pop-up at startup.
hotkey-overlay {
    skip-at-startup
}

// Fix for electron-based applications running electron >28.
environment {
      XDG_SESSION_TYPE "wayland"
}

// Screenshot path and name.
screenshot-path "~/pictures/screenshots/%F-%H-%M-%S.png"

// I/O device configuration.
include optional=true "devices.kdl"
// Monitor mode and layout configuration.
include optional=true "monitors.kdl"
// Theme and animation configuration.
include optional=true "theme.kdl"
// Window rule configuration.
include optional=true "rules.kdl"
// Key binding configuration.
include "keybinds.kdl"
// Program auto starting configutaion.
include optional=true "autostart.kdl"
