input {
    keyboard {
        repeat-rate 35
        repeat-delay 300
        // Set numlock on by default.
        numlock
    }

    touchpad {
        // Disable trackpad acceleration
        accel-profile "flat"
        // Sensitivity
        accel-speed 0.75
    }

    // Thinkpad red button
    trackpoint {
        // Disable trackpoint acceleration
        accel-profile "flat"
        // Sensitivity
        accel-speed 0.25
    }
}
