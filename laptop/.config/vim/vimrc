" map leader key for custom commands
let g:mapleader=" "
let g:maplocalleader=" "

" relative line numbers except on the current line
set number
set relativenumber

" disable wrapping when line is too long
set nowrap

" disable swapfiles
set noswapfile

" ensure xdg specification compatibility
set runtimepath^=$XDG_CONFIG_HOME/vim
set runtimepath+=$XDG_DATA_HOME/vim
set runtimepath+=$XDG_CONFIG_HOME/vim/after

set packpath^=$XDG_DATA_HOME/vim,$XDG_CONFIG_HOME/vim
set packpath+=$XDG_DATA_HOME/vim/after,$XDG_CONFIG_HOME/vim/after

let g:netrw_home = $XDG_DATA_HOME."/vim"
call mkdir($XDG_DATA_HOME."/vim/spell", 'p')

set backupdir=$XDG_STATE_HOME/vim/backup | call mkdir(&backupdir, 'p')
set directory=$XDG_STATE_HOME/vim/swap | call mkdir(&directory, 'p')
set undodir=$XDG_STATE_HOME/vim/undo | call mkdir(&undodir, 'p')
set viewdir=$XDG_STATE_HOME/vim/view | call mkdir(&viewdir, 'p')

if !has('nvim') | set viminfofile=$XDG_STATE_HOME/vim/viminfo | endif

" set default tabstop
set tabstop=4
set shiftwidth=4
set expandtab

" enable search highlighting
set hlsearch

" enable color scheme
set termguicolors
set t_Co=256
colorscheme catppuccin

" enable syntax highlighting
syntax enable

" keybinds
nnoremap <leader>o :update<CR>:source $MYVIMRC<CR>:echom "Updated and sourced the vimrc at: " $MYVIMRC<CR>
nnoremap <leader>w :write<CR>
nnoremap <leader>q :quit<CR>
nnoremap <CR> o<Esc>
" note that this won't work on a linux TTY as the difference between Shift + Enter and Enter is not detected
nnoremap <S-CR> O<Esc>
