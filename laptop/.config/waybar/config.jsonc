{
    // Bar style
    "layer": "top", // Bar goes over the top of windows
    "position": "top",

    "spacing": 0, // Padding is added to individual modules
    "width": 1161, // 0.85 of total width
    "height": 32, // 0.04 of total height

    "margin": "0 6px 0 6px",

    // Module layout
    "modules-left": [
        "cpu",
        "memory",
        "disk",
    ],
    "modules-center": [
        "clock",
    ],
    "modules-right": [
        "wireplumber",
        "network",
        "battery",
    ],

    // Module config
    "include": [
        "~/.config/waybar/module-config.jsonc",
    ],
}
