{{- /* Variables to prompt for on initial setup */ -}}

{{- $choices := list "pc" "laptop" -}}
{{- $host := promptChoiceOnce . "host" "What type of machine is this?" $choices -}}
{{- $email := promptStringOnce . "email" "What is the email of your github account?" -}}
{{- $username := promptStringOnce . "username" "What is the username of your github account?" -}}

{{- /* Variables to derive */ -}}

{{- /* Defaults */ -}}
{{- $xdg_documents_dir := joinPath .chezmoi.homeDir "documents" -}}
{{- $xdg_music_dir := joinPath .chezmoi.homeDir "music" -}}
{{- $xdg_pictures_dir := joinPath .chezmoi.homeDir "pictures" -}}
{{- $xdg_videos_dir := joinPath .chezmoi.homeDir "videos" -}}
{{- $browser := "librewolf" -}}
{{- /* Non-default (strange) overrides */ -}}
{{- if eq $host "pc" -}}
{{-   $xdg_music_dir = "/mnt/kingston/linux-storage/data/music" -}}
{{-   $xdg_pictures_dir = "/mnt/kingston/linux-storage/data/pictures" -}}
{{-   $xdg_videos_dir = "/mnt/kingston/linux-storage/data/videos" -}}
{{- else if eq $host "laptop" -}}
{{-   $browser = "qutebrowser" -}}
{{- end -}}

[data]
    host = {{ $host | quote }}
    email = {{ $email | quote }}
    username = {{ $username | quote }}

    xdg_documents_dir = {{ $xdg_documents_dir | quote }}
    xdg_music_dir = {{ $xdg_music_dir | quote }}
    xdg_pictures_dir = {{ $xdg_pictures_dir | quote }}
    xdg_videos_dir = {{ $xdg_videos_dir | quote }}

    browser = {{ $browser | quote }}

