#!/bin/sh

APP_ID=""
TERM_SIZE="120x40"

# Parse flags manually. 
# The loop stops at the first unrecognized argument (the start of your command)
while [ $# -gt 0 ]; do
    case "$1" in
        -a) APP_ID="$2"; shift 2 ;;
        -s) TERM_SIZE="$2"; shift 2 ;;
        *) break ;; # Reached the command to launch
    esac
done

# Exit if no command was given
if [ $# -eq 0 ]; then
    echo "Usage: $0 [-a app_id] [-s terminal_size (e.g., 140x50)] command [args...]" >&2
    exit 1
fi

# If an App ID is provided, try to focus it first
if [ -n "$APP_ID" ]; then
    niri msg action focus-window --app-id "$APP_ID" >/dev/null 2>&1 && exit 0

    # If the window isn't found (or IPC fails), replace shell with footclient (with app-id)
    exec footclient --window-size-chars="$TERM_SIZE" --app-id="$APP_ID" "$@"
fi

# If no App ID was provided, bypass focus logic and launch normally
exec footclient --window-size-chars="$TERM_SIZE" "$@"
