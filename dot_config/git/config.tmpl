[user]
	email = {{ .email }}
    name = {{ .username }}
[filter "lfs"]
	clean = git-lfs clean -- %f
	smudge = git-lfs smudge -- %f
	process = git-lfs filter-process
	required = true
[init]
	defaultBranch = master
[push]
	followTags = true
[alias]
    release-dev = "!f() { \
        git push origin dev && \
        git checkout master && \
        git pull origin master && \
        git merge --edit origin/dev && \
        git push origin master; \
    }; f"
[core]
	autocrlf = input
