// Window size rules

// Windows which should default to 50% size
window-rule {
    match app-id="foot"
    match app-id="org.prismlauncher.PrismLauncher"
    default-column-width { proportion 0.5; }
}

// Window workspace restrictions
window-rule {
    match app-id="qutebrowser"
    match app-id="librewolf"
    match app-id="firefox"
    match app-id="floorp"
    open-on-workspace "browser"
}
window-rule {
    match app-id="obsidian"
    open-on-workspace "notes"
}
window-rule {
    match app-id="discord"
    match app-id="vesktop"
    open-on-workspace "chat"
}

// Floating window overrides
// Browser PiP modes
window-rule {
    match app-id="firefox" title="&Picture-in-Picture$"
    match app-id="floorp" title="^Picture-in-Picture$"
    match app-id="librewolf" title="^Picture-in-Picture$"
    match app-id="qutebrowser" title="^Picture-in-Picture$"
    open-floating true
}
// Desktop utilities
window-rule {
    match app-id="app-launcher"
    match app-id="termfilechooser"
    open-floating true
}

// Black out sensitive applications from screen capture
window-rule {
    match app-id=r#"^org\.keepassxc\.KeePassXC$"#
    match app-id=r#"^org\.gnome\.World\.Secrets$"#
    block-out-from "screen-capture"
}
