// Workspaces (in order)
workspace "browser"
workspace "dev"
workspace "notes"
workspace "chat"

// Screenshot path and name.
screenshot-path "{{ .xdg_pictures_dir }}/screenshots/%F-%H-%M-%S.png"

// I/O device configuration.
include optional=true "devices.kdl"
// Layout, styling and animation configuration.
include optional=true "theme.kdl"
// Color configuration
include optional=true "colors.kdl"
// Window rule configuration.
include optional=true "rules.kdl"
// Key binding configuration.
include "keybinds.kdl"
// Application launching/software specific keybinds
include optional=true "application-keybinds.kdl"
// Program auto starting configutaion.
include optional=true "autostart.kdl"
