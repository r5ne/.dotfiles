binds {
    Mod+Shift+T hotkey-overlay-title="Open the terminal" { spawn "footclient"; }
    Mod+Shift+B hotkey-overlay-title="Open {{ .browser }}" { spawn "{{ .browser }}"; }
    Mod+Shift+N hotkey-overlay-title="Open obsidian" { spawn-sh "obsidian --enable-features=UseOzonePlatform --ozone-platform-hint=auto"; }
    Mod+Shift+D hotkey-overlay-title="Open discord" { spawn "discord"; }
}
