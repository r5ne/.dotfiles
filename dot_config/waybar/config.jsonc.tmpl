{
    // Bar style
    "layer": "top", // Bar goes over the top of windows
    "position": "top",

    "spacing": 0, // Padding is added to individual modules
    "width": {{ index .waybar .host "width" }}, // 0.85 of total width
    "height": {{ index .waybar .host "height" }}, // 0.04 of total height

    // Module layout
    "modules-left": [
        "cpu",
        "memory",
        "disk",
    ],
    "modules-center": [
        "clock",
    ],
    "modules-right": [
        {{ if eq .host "pc" }}"cava",{{ end }}
        "wireplumber",
        "network",
        {{ if eq .host "laptop" }}"battery",{{ end }}
    ],

    // Module config
    "include": [
        "./module-config.jsonc",
    ],
}
