{
    "cpu": {
        "interval": {{ if eq .host "laptop" }}20{{ else }}10{{ end }},
        "format": "{usage}% CPU usage",
    },
    "memory": {
        "interval": 5,
        "unit": "GB",
        "format": "{used:0.1f} GB ({percentage}%) RAM usage",
    },
    "disk": {
        "interval": 120,
        {{ if eq .host "pc" }}"path": "/",{{ end }}
        "format": "{specific_used:<0.1f} GB ({percentage_used}%) used on {path}",
        "unit": "GB",
    },
    "pulseaudio": {
        "format": "{volume}% volume",
        "format-muted": "Audio muted",
        "on-click": "wiremix",
    },
    "wireplumber": {
        "format": "{volume}% volume",
        //"format": "{volume}% ({volume_db}dB) volume",
        "tooltip-format": "Playing from {source_desc}",
        "format-muted": "Audio muted",
        "on-click": "wiremix",
    },
    "clock": {
        "format": "{:L%A %H:%M}",
        "tooltip-format": "<span>calendar</span>",
        "calendar": {
            "mode": "month",
            "mode-mon-col": 3,
        },
    },
    "network": {
        "format-wifi": "{essid} ({signalStrength}%)", 
        "format-disconnected": "Network disconnected",

        "interval": 10,
        "spacing": 1,
        "on-click": "impala",
    },
    {{- if eq .host "pc" }}
    "cava": {
        "cava_config": "$XDG_CONFIG_HOME/cava/waybar_raw.conf",
        "input_delay": 2,
        "format-icons" : ["▁", "▂", "▃", "▄", "▅", "▆", "▇", "█" ],
        "actions": {
                   "on-click-right": "mode"
                   }
    },
    {{- else if eq .host "laptop" }}
    "battery": {
        "format": "{capacity}% battery",
        "format-charging": "{capacity}% charging",
        "format-discharging": "{capacity}% discharging",
        "format-full": "Fully charged",
        "interval": 10,
    },
    {{- end }}
}
